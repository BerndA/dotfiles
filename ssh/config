Include ~/.ssh/conf.d/*.cfg

Host *
    UserKnownHostsFile ~/.ssh/known_hosts.d/%k
    CanonicalizeHostname yes
    ControlPath ~/.ssh/cmasters/%r@%h:%p
    ControlMaster auto
    ControlPersist 120
    IdentitiesOnly yes
    IdentityFile %d/.ssh/keys/id_%h_%r
    ForwardAgent no

#Host *+*
  ProxyCommand ssh $(echo %h | sed 's/+[^+]*$//;s/\([^+%%]*\)%%\([^+]*\)$/\2 -l \1/;s/:/ -p /') exec nc -w1 $(echo %h | sed 's/^.*+//;/:/!s/$/ %p/;s/:/ /')
